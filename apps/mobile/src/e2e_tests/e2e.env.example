# Flex Maestro E2E credentials — copy to e2e.env (gitignored) and fill in real values.
#
#   cp src/e2e_tests/e2e.env.example src/e2e_tests/e2e.env
#
# Maestro reads MAESTRO_* variables from the shell automatically.
# npm run test:e2e sources e2e.env before invoking Maestro.

MAESTRO_E2E_EMAIL=your-test-user@example.com
MAESTRO_E2E_PASSWORD=your-secure-password

# Optional: account without completed profile (onboarding flows)
# MAESTRO_E2E_ONBOARDING_EMAIL=onboarding-user@example.com
# MAESTRO_E2E_ONBOARDING_PASSWORD=your-secure-password
