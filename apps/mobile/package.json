{
  "name": "@flex/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start --reset-cache",
    "android": "npm run setup-env -- development && bash ./src/shared/scripts/dev/launchAndroidEmulator.sh && react-native run-android",
    "android-local": "npm run setup-env -- local && bash ./src/shared/scripts/dev/launchAndroidEmulator.sh && react-native run-android",
    "android-staging": "npm run setup-env -- staging && bash ./src/shared/scripts/dev/launchAndroidEmulator.sh && react-native run-android",
    "android-production": "npm run setup-env -- production && bash ./src/shared/scripts/dev/launchAndroidEmulator.sh && react-native run-android",
    "android:device": "react-native run-android --deviceId",
    "android:device-list": "adb devices",
    "ios": "npm run setup-env -- development && cd ios && pod install && cd .. && react-native run-ios",
    "ios-local": "npm run setup-env -- local && cd ios && pod install && cd .. && react-native run-ios",
    "ios-staging": "npm run setup-env -- staging && cd ios && pod install && cd .. && react-native run-ios",
    "ios-production": "npm run setup-env -- production && cd ios && pod install && cd .. && react-native run-ios",
    "ios:device": "npm run setup-env -- development && react-native run-ios --device",
    "build:ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios'",
    "setup-env": "tsx ./src/networkRequests/apiClient/setEnv.scripts.ts",
    "copy-env-file-to-android": "cp ./src/networkRequests/environmentVariables/env.json ./android/app/src/main/assets/",
    "enable-hermes": "tsx ./src/shared/scripts/build/enableHermes.scripts.ts",
    "remove-console-statements": "tsx ./src/shared/scripts/build/removeConsoleStatements.scripts.ts",
    "toggle-features": "tsx ./src/shared/scripts/build/toggleFeatures.scripts.ts",
    "remove-demo-code": "tsx ./src/shared/scripts/build/removeDemoCode.scripts.ts",
    "splash-images-setup": "tsx ./src/shared/scripts/SplashScreenGenerator/splashScreenSetup.scripts.ts && cd android && ./gradlew clean && cd ..",
    "splash-portrait-generate": "tsx ./src/shared/scripts/SplashScreenGenerator/splashScreenPortraitGenerator.scripts.ts",
    "splash-landscape-generate": "tsx ./src/shared/scripts/SplashScreenGenerator/splashScreenLandscapeGenerator.scripts.ts",
    "splash-change": "tsx ./src/shared/scripts/SplashScreenGenerator/splashScreenChange.scripts.ts",
    "emulator": "bash ./src/shared/scripts/dev/launchAndroidEmulator.sh",
    "update-git-hooks": "tsx ./src/shared/scripts/git/updateGitHooks.scripts.ts",
    "generate:component": "tsx ./src/shared/scripts/react/generateComponent.scripts.ts",
    "generate:screen": "tsx ./src/shared/scripts/react/generateScreen.scripts.ts",
    "generate:slice": "tsx ./src/shared/scripts/redux/generateApiReduxState.scripts.ts",
    "check:product-flow-docs": "tsx ./src/shared/scripts/productFlows/checkProductFlowDocsDrift.scripts.ts",
    "lint": "eslint ./ --fix --format=node_modules/eslint-formatter-pretty",
    "lint-validate": "eslint ./ --quiet",
    "tsc": "tsc --noEmit",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --color",
    "clean": "npm run clean-android; npm run clean-ios; npm run clean-general",
    "clean-android": "cd android && ./gradlew clean && cd ..",
    "clean-ios": "rm -rf ~/Library/Developer/Xcode/DerivedData/* | echo 'y'; rm -rf ios/build; rm -rf ios/Podfile.lock; cd ios && pod deintegrate && cd ..",
    "clean-general": "rm -rf $TMPDIR/react-*; watchman watch-del-all; rm -rf package-lock.json; rm -rf node_modules/; npm cache clean --force",
    "clean:install": "npm run clean && npm install && npm run start",
    "prepare": "husky",
    "postinstall": "patch-package && jetifier",
    "create-patch": "patch-package"
  },
  "dependencies": {
    "@flex/shared": "*",
    "@react-navigation/bottom-tabs": "7.2.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "@react-navigation/native": "7.0.13",
    "@react-navigation/native-stack": "7.1.14",
    "@reduxjs/toolkit": "2.4.0",
    "react-redux": "9.2.0",
    "axios": "1.7.9",
    "qs": "6.13.1",
    "react-hook-form": "7.54.0",
    "@hookform/resolvers": "3.9.1",
    "yup": "1.6.1",
    "i18next": "24.2.0",
    "react-i18next": "15.4.0",
    "luxon": "3.5.0",
    "lodash": "4.17.21",
    "react-native-mmkv": "3.1.0",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-native-clipboard/clipboard": "1.14.3",
    "@react-native-community/netinfo": "11.4.1",
    "react-native-keychain": "9.2.2",
    "react-native-device-info": "14.0.4",
    "react-native-permissions": "5.2.5",
    "react-native-safe-area-context": "5.0.0",
    "react-native-screens": "4.4.0",
    "react-native-gesture-handler": "2.21.2",
    "react-native-reanimated": "3.16.6",
    "react-native-svg": "15.10.1",
    "react-native-splash-screen": "3.3.0",
    "rxjs": "7.8.1",
    "uuid": "11.0.3",
    "libphonenumber-js": "1.11.17",
    "jail-monkey": "2.8.0",
    "react-native-get-random-values": "1.11.0",
    "@babel/runtime": "7.26.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "18.3.17",
    "@types/lodash": "4.17.13",
    "@types/luxon": "3.4.2",
    "@types/qs": "6.9.17",
    "@types/uuid": "10.0.0",
    "@types/jest": "29.5.14",
    "@react-native-community/cli": "15.1.3",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "tsx": "4.19.2",
    "jest": "29.7.0",
    "@testing-library/react-native": "13.0.1",
    "@testing-library/jest-native": "5.4.3",
    "react-test-renderer": "18.3.1",
    "eslint": "9.17.0",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.17.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "@trivago/prettier-plugin-sort-imports": "5.2.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-config-prettier": "9.1.0",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "jimp": "1.6.0",
    "patch-package": "8.0.0",
    "jetifier": "2.0.0",
    "babel-plugin-module-resolver": "5.0.2",
    "react-native-svg-transformer": "1.5.0",
    "@babel/core": "7.26.0",
    "@babel/preset-env": "7.26.0",
    "babel-jest": "29.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
