## VALIDATION SCHEMAS REQUIREMENTS

In Model File:
```typescript
export const {camelName}Body = zodd.object({
  // Define properties here
})

export const {camelName}QueryParam = zodd.object({
  {camelName}Id: commonValidations.id.openapi({
    example: '1',
    description: 'The identifier for the {API Name} to update'
  })
})

export const Incoming{SentenceName}Body = zodd.object({
  body: {camelName}Body
})

export const IncomingUpdate{SentenceName}Request = zodd.object({
  body: {camelName}Body,
  query: {camelName}QueryParam
})

export const IncomingDelete{SentenceName}Request = zodd.object({
  query: {camelName}QueryParam
})
```

## REPOSITORY PATTERN REQUIREMENTS

Database Operations (implement only the methods needed for your API's functionality):
```typescript
export const {camelName}Repository = {
  // For CREATE operations
  add{SentenceName}: async function (userId: number, new{SentenceName}: {SentenceName}) {
    // Check limits, create entity
  },
  
  // For READ operations
  get{SentenceName}s: async function (userId: number) {
    // Retrieve all entities for user
  },
  
  // For UPDATE operations
  update{SentenceName}: async function (userId: number, {camelName}Id: number, new{SentenceName}: Update{SentenceName}Request) {
    // Update existing entity
  },
  
  // For DELETE operations
  delete{SentenceName}: async function (userId: number, {camelName}Id: number) {
    // Delete entity
  },
  
  // Helper method for operations that need to find by ID
  get{SentenceName}ById: async function ({camelName}Id: number) {
    // Get single entity by ID (used by update/delete operations)
  },
  
  // For CUSTOM ACTIONS (examples)
  activate{SentenceName}: async function (userId: number, {camelName}Id: number) {
    // Custom business logic for activation
  },
  
  search{SentenceName}s: async function (userId: number, searchParams: SearchParams) {
    // Custom search logic
  }
}
```

## SERVICE LAYER REQUIREMENTS
Implement only the service methods needed for your API's functionality:
```typescript
export const {camelName}Service = {
  // For CREATE operations
  add{SentenceName}: async ({camelName}: {SentenceName}) => {
    const currentUser = getCurrentLoggedInUserOrThrow()
    // Call repository
  },
  
  // For READ operations
  get{SentenceName}s: async () => {
    const currentUser = getCurrentLoggedInUserOrThrow()
    // Call repository
  },
  
  // For UPDATE operations
  update{SentenceName}: async ({camelName}Id: number, update{SentenceName}Request: Update{SentenceName}Request) => {
    const currentUser = getCurrentLoggedInUserOrThrow()
    // Call repository
  },
  
  // For DELETE operations
  delete{SentenceName}: async ({camelName}Id: number) => {
    const currentUser = getCurrentLoggedInUserOrThrow()
    // Call repository
  },
  
  // For CUSTOM ACTIONS (examples)
  activate{SentenceName}: async ({camelName}Id: number) => {
    const currentUser = getCurrentLoggedInUserOrThrow()
    // Custom business logic, call repository
  },
  
  search{SentenceName}s: async (searchParams: SearchParams) => {
    const currentUser = getCurrentLoggedInUserOrThrow()
    // Custom search logic, call repository
  }
}
```

