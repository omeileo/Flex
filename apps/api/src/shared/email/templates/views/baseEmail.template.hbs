<!DOCTYPE html>
<html lang='en'>

<head>
  <meta charset='UTF-8' />
  <meta name='viewport' content='width=device-width, initial-scale=1.0' />
  <title>{{subject}}</title>
  {{!-- {{> emailStyles}} --}}

  <style type='text/css'>
    /* Reset styles for email clients */
    body,
    p,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      margin: 0;
      padding: 0;
    }

    body,
    table,
    td,
    p,
    a,
    li,
    blockquote {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      font-family: 'DM Sans', Arial, Helvetica, sans-serif !important;
      font-size: 16px !important;
      line-height: 24px !important;
    }

    body {
      margin: 0;
      padding: 20px;
      background-color: #f4f4f4 !important;
      font-family: 'DM Sans', Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      width: 100% !important;
    }

    /* Gmail-specific fixes */
    * {
      -webkit-text-size-adjust: none;
    }

    /* Container table */
    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #f4f4f4;
      padding-bottom: 40px;
    }

    .header {
      width: 100%;
      max-width: 600px;
      text-align: center;
      padding: 40px 0;
    }

    .content-wrapper {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 16px;
      border-spacing: 0;
    }

    .content {
      padding: 32px;
      text-align: center;
    }

    h1 {
      color: #1F2937;
      font-size: 28px;
      line-height: 32px;
      margin-bottom: 16px;
      font-weight: bold;
    }

    p {
      color: #4B5563;
      font-size: 16px;
      line-height: 24px;
      margin-bottom: 24px;
    }

    .action-button {
      background-color: #6D28D9;
      color: #ffffff;
      display: inline-block;
      padding: 12px 32px;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      margin: 24px 0;
    }

    .additional-content {
      font-size: 12px;
      line-height: 18px;
      margin-top: 16px;
    }

    .additional-content a {
      color: #4338CA;
      text-decoration: underline;
    }

    .salutations {
      font-size: 12px;
      line-height: 18px;
    }

    .footer {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      text-align: center;
      padding: 24px 0;
    }

    .footer-text {
      color: #9CA3AF;
      font-size: 12px;
      line-height: 18px;
      margin: 8px 0;
    }

    /* Fix for logo size in Apple Mail */
    .logo-image {
      width: 90px !important;
      height: 90px !important;
      max-width: 90px !important;
      max-height: 90px !important;
      -ms-interpolation-mode: bicubic;
      display: block;
    }
  </style>
</head>

<body>
  <table class='wrapper' cellpadding='0' cellspacing='0' role='presentation'>
    <tr>
      <td align='center'>
        <!-- Header Section -->
        <table class='header' cellpadding='0' cellspacing='0' role='presentation'>
          <tr>
            <td align='center'>
              <img src='cid:template-project-logo' alt='{{businessName}}' class='logo-image' />
            </td>
          </tr>
        </table>

        <!-- Main Content -->
        <table class='content-wrapper' cellpadding='0' cellspacing='0' role='presentation'>
          <tr>
            <td class='content'>
              <!-- Title Section -->
              <h1>{{title}}</h1>

              <!-- Main Content Section -->
              <p>
                Hi {{firstName}},<br /><br />
                {{{content}}}
              </p>

              <!-- Optional Button Section -->
              {{#if buttonConfig}}
              <table role='presentation' cellpadding='0' cellspacing='0' style='margin: 0 auto;'>
                <tr>
                  <td>
                    <a href='{{buttonConfig.link}}' class='action-button' style='color: #ffffff;'>
                      {{buttonConfig.text}}
                    </a>
                  </td>
                </tr>
              </table>
              {{/if}}

              <!-- Optional Additional Content Section -->
              {{#if additionalContent}}
              <p class='additional-content'>
                {{{additionalContent}}}
              </p>
              {{/if}}

              <!-- Salutations Section -->
              <p class='salutations'>
                {{#if customSalutation}}
                {{{customSalutation}}}
                {{else}}
                Best,<br />
                The {{businessName}} Team
                {{/if}}
              </p>
            </td>
          </tr>
        </table>

        <!-- Footer Section -->
        <table class='footer' cellpadding='0' cellspacing='0' role='presentation'>
          <tr>
            <td align='center'>
              <p class='footer-text'>
                Let us know if you have any feedback or issues at
                <a href='mailto:{{supportEmail}}' style='color: #4338CA;'>{{supportEmail}}</a>
              </p>
              <p class='footer-text'>{{businessAddress}}</p>
              <p class='footer-text'>&copy; {{currentYear}} {{businessName}}</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>