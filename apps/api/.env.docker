# Server Configuration
NODE_ENV="local"
LOG_LEVEL="info"
PORT="3005"
HOST="localhost"
APP_BASE_PATH="/api" # "" blank string for root path 

# CORS Settings
CORS_ORIGIN="http://localhost:3000,https://dev.appshop.biz"

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="60000"
COMMON_RATE_LIMIT_MAX_REQUESTS="1000"

# PostgreSQL Configuration
DATABASE_URL=postgres://template-project:template-project@localhost:3006/db?schema=public

# Token Expiry Settings
PASSWORD_RESET_TOKEN_EXPIRY="3600000"
VERIFY_EMAIL_TOKEN_EXPIRY="86400000"

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
