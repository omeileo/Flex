generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Audit Logs Table
// This table keeps track of user actions for auditing purposes
model audit_logs {
  id             String   @id @db.VarChar(64)
  user_id        String?  @db.VarChar(64)
  user_role      String?
  action         String   @db.VarChar(255)
  ip_address     String?  @db.VarChar(45)
  initiator_type String?
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamp(6)
  users          users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "index_audit_logs_user_id")
}

// Blacklisted Tokens Table
// This table stores tokens that have been invalidated or blacklisted
model blacklisted_tokens {
  id        String   @id @db.VarChar(64)
  token     String   @unique

  created_at DateTime @default(now()) @db.Timestamp(6)
}

// Email Verification Tokens Table
// This table stores tokens used for email verification
model email_verification_tokens {
  id         String   @id @db.VarChar(64)
  user_id    String   @db.VarChar(64)
  token      String   @unique(map: "index_email_verification_tokens_token") @db.VarChar(255)
  short_code String   @unique(map: "index_email_verification_tokens_short_code") @db.VarChar(6)

  created_at DateTime @default(now()) @db.Timestamp(6)
  expires_at DateTime @db.Timestamp(6)

  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "index_email_verification_tokens_user_id")
}

// Notifications Table
// This table stores notifications sent to users
model notifications {
  id                 String   @id @db.VarChar(64)
  recipient_id       String   @db.VarChar(64)
  author_id          String   @db.VarChar(64)
  author_type        String @db.VarChar(50) // system, user
  type               String @db.VarChar(50) // alert, notification
  priority           String @db.VarChar(50) // low, medium, high
  delivery_status_id String   @db.VarChar(64)
  read_status_id     String?  @db.VarChar(64)

  created_at                                      DateTime  @default(now()) @db.Timestamp(6)
  updated_at                                      DateTime? @db.Timestamp(6)
  status_notifications_delivery_status_idTostatus status    @relation("notifications_delivery_status_idTostatus", fields: [delivery_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status_notifications_read_status_idTostatus     status?   @relation("notifications_read_status_idTostatus", fields: [read_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                           users     @relation(fields: [recipient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  notification_contents                notification_contents[]

  @@index([delivery_status_id], map: "index_notifications_delivery_status_id")
  @@index([read_status_id], map: "index_notifications_read_status_id")
  @@index([recipient_id], map: "index_notifications_recipient_id")
}

// Notification Contents Table
// This table stores the contents of notifications
model notification_contents {
  id               String   @id @db.VarChar(64)
  notification_id  String   @db.VarChar(64)
  title            String @db.VarChar(255)
  body             String
  delivery_channel String @db.VarChar(255) // email, push, sms, in-app
  template_id      String?  @db.VarChar(64)

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  notifications notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([template_id], map: "index_notification_contents_template_id")
  @@index([notification_id], map: "index_notification_contents_notification_id")
  @@index([title], map: "index_notification_contents_title")
}

// Notification Templates Table
// This table stores information about notification templates
model notification_templates {
  id               String   @id @db.VarChar(64)
  name             String @db.VarChar(255)
  description      String
  template_content String

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  @@index([name], map: "index_notification_templates_name")
}

// Password Reset Tokens Table
// This table stores password reset tokens for users
model password_reset_tokens {
  id         String   @id @db.VarChar(64)
  user_id    String   @db.VarChar(64)
  token      String   @unique(map: "index_password_reset_tokens_token") @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
  expires_at DateTime @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "index_password_reset_tokens_user_id")
}

// Payment Changes Table
// This table stores changes made to payment information
model payment_changes {
  id                    String   @id @db.VarChar(64)
  payment_id            String   @db.VarChar(64)
  change_initiator_type String   @db.VarChar(50)
  change_initiator_id   String   @db.VarChar(64)
  change_type           String   @db.VarChar(50)
  old_value             String?
  new_value             String?
  change_time           DateTime @default(now()) @db.Timestamp(6)
  users                 users    @relation(fields: [change_initiator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments              payments @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([change_initiator_id, change_initiator_type], map: "index_payment_changes_initiator")
  @@index([payment_id], map: "index_payment_changes_payment_id")
}

// Payments Table
// This table stores information about payments made by users
model payments {
  id             String   @id @db.VarChar(64)
  initiator_type String   @db.VarChar(50)
  initiator_id   String   @db.VarChar(64)
  total          Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  tax            Decimal  @db.Decimal(10, 2)
  fees           Decimal  @db.Decimal(10, 2)
  stripe_fee     Decimal? @db.Decimal(10, 2)
  delivery_fee   Decimal? @db.Decimal(10, 2)
  discount       Decimal  @db.Decimal(10, 2)
  currency       String   @db.VarChar(10)
  status_id      String   @db.VarChar(64)
  metadata       Json?

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  payment_changes                 payment_changes[]
  users                           users?                                         @relation(fields: [initiator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status                          status                                         @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refund_requests                 refund_requests[]
  stripe_payment_details          stripe_payment_details[]

  @@index([initiator_id, initiator_type], map: "index_payments_initiator")
  @@index([status_id], map: "index_payments_status_id")
}

// Payment Intents Table
// This table stores payment intents for payments made by users
model stripe_payment_intents {
  id                String   @id @db.VarChar(64)
  payment_intent_id String @unique(map: "index_payment_intents_payment_intent_id") @db.VarChar(255)
  user_id           String   @db.VarChar(64)

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([payment_intent_id], map: "index_stripe_payment_intents_payment_intent_id")
}

// External System Payment Details Table
// This table stores payment details for external system payments received from users via Stripe.
model stripe_payment_details {
  id                  String   @id @db.VarChar(64)
  payment_id          String   @db.VarChar(64)
  payment_intent_id   String    @unique(map: "index_external_system_payment_details_payment_intent_id") @db.VarChar(255)
  payment_status      String    @db.VarChar(255)
  amount              Decimal   @db.Decimal(10, 2)
  canceled_at         DateTime? @db.Timestamp(6)
  cancellation_reason String?   @db.VarChar(255)

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  payments        payments          @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refund_requests refund_requests[]

  @@index([payment_id], map: "index_external_system_payment_details_payment_id")
}

// Tax Countries Table
// This table stores information about different countries for tax purposes
model tax_countries {
  id   String   @id @db.VarChar(64)
  code String? @unique
  name String

  tax_rates                            tax_rates[]
  tax_exemptions                       tax_exemptions[]
  tax_country_administrative_divisions tax_country_administrative_divisions[]

  @@index([name], map: "index_tax_countries_name")
  @@index([code], map: "index_tax_countries_code")
}

// Tax Country Administrative Divisions Table
// This table stores information about different administrative divisions within a country for tax purposes
// For example, if the country is the United States, the administrative divisions would be the states.
// If the country is Canada, the administrative divisions would be the provinces.
model tax_country_administrative_divisions {
  id         String   @id @db.VarChar(64)
  name       String
  country_id String   @db.VarChar(64)
  type       String

  tax_rates      tax_rates[]
  tax_exemptions tax_exemptions[]
  tax_countries  tax_countries    @relation(fields: [country_id], references: [id])

  @@index([country_id], map: "index_tax_country_administrative_divisions_country_id")
  @@index([name], map: "index_tax_country_administrative_divisions_name")
}

// Tax Rates Table
// This table stores sales tax rates for different locations
model tax_rates {
  id                         String   @id @db.VarChar(64)
  rate                       Decimal @db.Decimal(5, 4)
  country_id                 String?  @db.VarChar(64)
  administrative_division_id String?  @db.VarChar(64)

  country                 tax_countries?                        @relation(fields: [country_id], references: [id])
  administrative_division tax_country_administrative_divisions? @relation(fields: [administrative_division_id], references: [id])

  @@index([country_id], map: "index_tax_rates_country_id")
  @@index([administrative_division_id], map: "index_tax_rates_administrative_division_id")
}

// Tax Exemptions Table
// This table stores exemption information for specific categories of items
model tax_exemptions {
  id                                   String   @id @db.VarChar(64)
  administrative_division_id           String   @db.VarChar(64)
  tax_country_id                       String?  @db.VarChar(64)
  category                             String
  no_tax                               Boolean?
  conditional_exemption                Boolean?
  threshold_amount                     Decimal? @db.Decimal(10, 2)
  tax_price_difference_above_threshold Boolean?

  administrative_division tax_country_administrative_divisions @relation(fields: [administrative_division_id], references: [id])
  tax_countries           tax_countries?                       @relation(fields: [tax_country_id], references: [id])

  @@index([administrative_division_id], map: "index_tax_exemptions_administrative_division_id")
  @@index([tax_country_id], map: "index_tax_exemptions_tax_country_id")
}

// Permissions Table
// This table stores information about permissions that can be assigned to users
model permissions {
  id               String   @id @db.VarChar(64)
  name             String             @unique(map: "index_permissions_name") @db.VarChar(100)
  description      String?            @db.VarChar(255)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @db.Timestamp(6)
  role_permissions role_permissions[]
  user_permissions user_permissions[]
}

// Preferences Table
// This table stores information about user preferences
model preferences {
  id               String   @id @db.VarChar(64)
  name             String             @db.VarChar(255)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @db.Timestamp(6)
  user_preferences user_preferences[]
}

// Refund Requests Table
// This table stores information about refund requests made by users
model refund_requests {
  id                                 String   @id @db.VarChar(64)
  user_id                            String   @db.VarChar(64)
  refund_id                          String  @unique(map: "index_refund_requests_refund_id") @db.VarChar(255)
  external_system_payment_details_id String   @db.VarChar(64)
  paymentsId                         String?  @db.VarChar(64)
  status                             String  @db.VarChar(255)
  amount                             Decimal @db.Decimal(10, 2)
  currency                           String  @db.VarChar(10)
  refund_receipt_number              String? @db.VarChar(255)
  refund_reason                      String? @db.VarChar(255)
  refund_failure_reason              String? @db.VarChar(255)
  metadata                           Json?

  created_at DateTime
  updated_at DateTime? @db.Timestamp(6)

  stripe_payment_details stripe_payment_details @relation(fields: [external_system_payment_details_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                           users                           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments                        payments?                       @relation(fields: [paymentsId], references: [id])

  @@index([external_system_payment_details_id], map: "index_refund_requests_external_system_payment_details_id")
  @@index([user_id], map: "index_refund_requests_user_id")
}

// Role Permissions Table
// This table stores information about permissions assigned to roles
model role_permissions {
  id            String   @id @db.VarChar(64)
  role_id       String   @db.VarChar(64)
  permission_id String   @db.VarChar(64)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @db.Timestamp(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, permission_id], map: "index_role_permissions_unique")
  @@index([permission_id], map: "index_role_permissions_permission_id")
  @@index([role_id], map: "index_role_permissions_role_id")
}

// Roles Table
// This table stores information about roles that can be assigned to users
model roles {
  id               String   @id @db.VarChar(64)
  name             String             @unique(map: "index_roles_name") @db.VarChar(50)
  description      String?            @db.VarChar(255)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @db.Timestamp(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

// Status Table
// This table stores information about statuses that can be assigned to users, items, and other entities
model status {
  id           String   @id @db.VarChar(64)
  type_id      String   @db.VarChar(64)
  name         String @db.VarChar(50)
  description  String
  display_name String @db.VarChar(100)

  notifications_notifications_delivery_status_idTostatus notifications[]                                @relation("notifications_delivery_status_idTostatus")
  notifications_notifications_read_status_idTostatus     notifications[]                                @relation("notifications_read_status_idTostatus")
  payments                                               payments[]
  status_types                                           status_types                                   @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                  users[]

  @@unique([type_id, name], map: "index_status_type_name")
  @@index([name], map: "index_status_name")
  @@index([type_id], map: "index_status_type_id")
}

// Status Types Table
// This table stores information about the types of statuses that can be assigned to users, items, and other entities
model status_types {
  id          String   @id @db.VarChar(64)
  type        String   @unique(map: "index_status_types_type") @db.VarChar(50)
  description String
  status      status[]
}

// User Permissions Table
// This table stores information about permissions assigned to users
model user_permissions {
  id            String   @id @db.VarChar(64)
  user_id       String   @db.VarChar(64)
  permission_id String   @db.VarChar(64)
  is_granted    Boolean
  assigned_at   DateTime?   @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @db.Timestamp(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, permission_id], map: "index_user_permissions_unique")
  @@index([permission_id], map: "index_user_permissions_permission_id")
  @@index([user_id], map: "index_user_permissions_user_id")
}

// User Preferences Table
// This table stores information about user preferences
model user_preferences {
  id            String   @id @db.VarChar(64)
  user_id       String   @db.VarChar(64)
  preference_id String   @db.VarChar(64)
  value         Boolean     @default(false)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @db.Timestamp(6)
  preferences   preferences @relation(fields: [preference_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([preference_id], map: "index_user_preferences_preference_id")
  @@index([user_id], map: "index_user_preferences_user_id")
}

// User Profiles Table
// This table stores information about user profiles
model user_profiles {
  id                        String   @id @db.VarChar(64)
  stripe_customer_id        String?   @db.VarChar(255) //
  stripe_connect_account_id String?   @db.VarChar(255) // TODO: Normalize this into a new table
  firebase_user_id          String?   @db.VarChar(255)
  mobile_number             String?   @db.VarChar(20)
  first_name                String    @db.VarChar(255)
  middle_name               String?   @db.VarChar(255)
  last_name                 String    @db.VarChar(255)
  date_of_birth             DateTime? @db.Date

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  user users?

  @@index([first_name], map: "index_user_profiles_first_name")
  @@index([last_name], map: "index_user_profiles_last_name")
}

// User Roles Table
// This table stores information about roles assigned to users
model user_roles {
  id          String   @id @db.VarChar(64)
  user_id     String   @db.VarChar(64)
  role_id     String   @db.VarChar(64)
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  roles       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id], map: "index_user_roles_unique")
  @@index([role_id], map: "index_user_roles_role_id")
  @@index([user_id], map: "index_user_roles_user_id")
}

// User Sessions Table
// This table stores information about user sessions
model user_sessions {
  id            String   @id @db.VarChar(64)
  user_id       String   @db.VarChar(64)
  session_token String    @unique(map: "index_user_sessions_session_token") @db.VarChar(512)
  login_time    DateTime  @db.Timestamp(6)
  logout_time   DateTime? @db.Timestamp(6)
  is_active     Boolean   @default(true)
  ip_address    String?   @db.VarChar(45)
  user_agent    String?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "index_user_sessions_user_id")
}

// Users Table
// This table stores information about users
model users {
  id                String   @id @db.VarChar(64)
  email             String @unique(map: "index_users_email") @db.VarChar(255)
  password_hash     String @db.VarChar(255)
  user_status_id    String   @db.VarChar(64)
  user_profile_id   String   @db.VarChar(64)    @unique
  password_attempts Int    @default(0)

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  status                                            status                         @relation(fields: [user_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_1")
  user_profile                                      user_profiles                  @relation(fields: [user_profile_id], references: [id])
  audit_logs                                        audit_logs[]
  email_verification_tokens                         email_verification_tokens[]
  notifications                                     notifications[]
  password_reset_tokens                             password_reset_tokens[]
  payment_changes                                   payment_changes[]
  payments                                          payments[]
  refund_requests                                   refund_requests[]
  user_permissions                                  user_permissions[]
  user_preferences                                  user_preferences[]
  user_roles                                        user_roles[]
  user_sessions                                     user_sessions[]
  stripe_payment_intents                            stripe_payment_intents[]
  fitness_profile                                   fitness_profiles?
  training_plans                                    training_plans[]
  workout_sessions                                  workout_sessions[]
  user_app_settings                                 user_app_settings?
  workout_locations                                 workout_locations[]
  wellness_conditions                               wellness_conditions[]
  excluded_exercises                                excluded_exercises[]
  cycle_profiles                                    cycle_profiles?
}

model fitness_profiles {
  id                String   @id @db.VarChar(64)
  user_id           String   @db.VarChar(64)      @unique
  goal              String   @db.VarChar(255)
  experience_level  String   @db.VarChar(50)
  days_per_week     Int
  session_minutes   Int
  sex_at_birth      String?  @db.VarChar(30)
  age_band          String?  @db.VarChar(20)
  diet_preferences  Json     @default("[]")
  calorie_target    Int?
  equipment         Json     @default("[]")
  injuries          Json     @default("[]")
  preferences       Json?
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)

  users            users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  training_plans   training_plans[]
}

model exercises {
  id                String   @id @db.VarChar(64)
  name              String   @unique @db.VarChar(255)
  category          String   @db.VarChar(50)
  muscle_groups     Json     @default("[]")
  equipment         Json     @default("[]")
  video_url         String?  @db.VarChar(500)
  contraindications Json     @default("[]")
  created_at        DateTime @default(now()) @db.Timestamp(6)

  planned_exercises planned_exercises[]
  excluded_exercises excluded_exercises[]
}

model training_plans {
  id                   String   @id @db.VarChar(64)
  user_id              String   @db.VarChar(64)
  fitness_profile_id   String   @db.VarChar(64)
  status               String   @db.VarChar(50)
  week_number          Int      @default(1)
  plan_json            Json
  generation_changelog Json?
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @db.Timestamp(6)

  users              users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  fitness_profiles   fitness_profiles   @relation(fields: [fitness_profile_id], references: [id])
  plan_phases        plan_phases[]
  plan_change_log    plan_change_log[]
  workout_sessions   workout_sessions[]
  planned_workouts   planned_workouts[]

  @@index([user_id], map: "index_training_plans_user_id")
}

model plan_phases {
  id               String   @id @db.VarChar(64)
  training_plan_id String   @db.VarChar(64)
  name             String   @db.VarChar(255)
  week_start       Int
  week_end         Int
  goals            Json     @default("[]")
  rpe_range        String?  @db.VarChar(50)
  rest_defaults    Json?
  created_at       DateTime @default(now()) @db.Timestamp(6)

  training_plans training_plans @relation(fields: [training_plan_id], references: [id], onDelete: Cascade)
  plan_weeks     plan_weeks[]

  @@index([training_plan_id], map: "index_plan_phases_training_plan_id")
}

model plan_weeks {
  id            String @id @db.VarChar(64)
  plan_phase_id String @db.VarChar(64)
  week_number   Int

  plan_phases      plan_phases        @relation(fields: [plan_phase_id], references: [id], onDelete: Cascade)
  planned_workouts planned_workouts[]

  @@index([plan_phase_id], map: "index_plan_weeks_plan_phase_id")
}

model planned_workouts {
  id               String   @id @db.VarChar(64)
  training_plan_id String   @db.VarChar(64)
  plan_week_id     String?  @db.VarChar(64)
  day_index        Int
  name             String   @db.VarChar(255)
  warmup_notes     Json     @default("[]")
  created_at       DateTime @default(now()) @db.Timestamp(6)

  training_plans    training_plans      @relation(fields: [training_plan_id], references: [id], onDelete: Cascade)
  plan_weeks        plan_weeks?         @relation(fields: [plan_week_id], references: [id])
  workout_sections  workout_sections[]
  planned_exercises planned_exercises[]

  @@index([training_plan_id], map: "index_planned_workouts_training_plan_id")
}

model workout_sections {
  id                 String @id @db.VarChar(64)
  planned_workout_id String @db.VarChar(64)
  name               String @db.VarChar(255)
  order_index        Int

  planned_workout   planned_workouts    @relation(fields: [planned_workout_id], references: [id], onDelete: Cascade)
  planned_exercises planned_exercises[]

  @@index([planned_workout_id], map: "index_workout_sections_planned_workout_id")
}

model planned_exercises {
  id                  String  @id @db.VarChar(64)
  planned_workout_id  String  @db.VarChar(64)
  workout_section_id  String? @db.VarChar(64)
  exercise_id         String  @db.VarChar(64)
  order_index         Int
  sets_json           Json
  rest_seconds        Int     @default(90)
  notes               String?
  progression_template Json?

  planned_workout planned_workouts @relation(fields: [planned_workout_id], references: [id], onDelete: Cascade)
  workout_sections workout_sections? @relation(fields: [workout_section_id], references: [id])
  exercises        exercises         @relation(fields: [exercise_id], references: [id])

  @@index([planned_workout_id], map: "index_planned_exercises_planned_workout_id")
}

model plan_change_log {
  id               String   @id @db.VarChar(64)
  training_plan_id String   @db.VarChar(64)
  exercise_id      String?  @db.VarChar(64)
  field            String   @db.VarChar(50)
  previous_value   String?  @db.VarChar(255)
  next_value       String?  @db.VarChar(255)
  reason           String
  created_at       DateTime @default(now()) @db.Timestamp(6)

  training_plans training_plans @relation(fields: [training_plan_id], references: [id], onDelete: Cascade)

  @@index([training_plan_id], map: "index_plan_change_log_training_plan_id")
}

model workout_sessions {
  id                 String    @id @db.VarChar(64)
  training_plan_id   String    @db.VarChar(64)
  user_id            String   @db.VarChar(64)
  workout_day_index  Int
  started_at         DateTime  @default(now()) @db.Timestamp(6)
  completed_at       DateTime? @db.Timestamp(6)
  session_json       Json

  training_plans training_plans @relation(fields: [training_plan_id], references: [id], onDelete: Cascade)
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session_sets   session_sets[]

  @@index([training_plan_id], map: "index_workout_sessions_training_plan_id")
}

model session_sets {
  id                 String  @id @db.VarChar(64)
  workout_session_id String  @db.VarChar(64)
  exercise_id        String  @db.VarChar(64)
  set_number         Int
  reps_completed     Int?
  weight_kg          Float?
  rpe                Float?
  completed          Boolean @default(true)

  workout_sessions workout_sessions @relation(fields: [workout_session_id], references: [id], onDelete: Cascade)

  @@index([workout_session_id], map: "index_session_sets_workout_session_id")
}

model user_app_settings {
  id                         String   @id @db.VarChar(64)
  user_id                    String   @db.VarChar(64)      @unique
  theme_mode                 String   @default("light") @db.VarChar(20)
  active_workout_location_id String?  @db.VarChar(64)
  created_at                 DateTime @default(now()) @db.Timestamp(6)
  updated_at                 DateTime? @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "index_user_app_settings_user_id")
}

model workout_locations {
  id              String   @id @db.VarChar(64)
  user_id         String   @db.VarChar(64)
  name            String   @db.VarChar(255)
  preset_type     String   @db.VarChar(50)
  notes           String?
  is_default      Boolean  @default(false)
  bodyweight_only Boolean  @default(false)
  equipment       Json     @default("[]")
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "index_workout_locations_user_id")
}

model wellness_conditions {
  id                     String   @id @db.VarChar(64)
  user_id                String   @db.VarChar(64)
  body_area              String    @db.VarChar(50)
  label                  String?   @db.VarChar(255)
  status                 String    @db.VarChar(30)
  last_flare_up_at       DateTime? @db.Timestamp(6)
  movement_restrictions  Json      @default("[]")
  aggravating_exercises  Json      @default("[]")
  notes                  String?
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "index_wellness_conditions_user_id")
}

model excluded_exercises {
  id           String   @id @db.VarChar(64)
  user_id      String   @db.VarChar(64)
  exercise_id  String?  @db.VarChar(64)
  custom_label String?  @db.VarChar(255)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  users     users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercises exercises? @relation(fields: [exercise_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "index_excluded_exercises_user_id")
  @@index([exercise_id], map: "index_excluded_exercises_exercise_id")
}

model cycle_profiles {
  id                     String   @id @db.VarChar(64)
  user_id                String   @db.VarChar(64)       @unique
  enabled                Boolean   @default(false)
  last_period_start_at   DateTime  @db.Date
  avg_cycle_length_days  Int       @default(28)
  avg_period_length_days Int       @default(5)
  contraception          String?   @db.VarChar(50)
  tracked_symptoms       Json      @default("[]")
  data_source            String    @default("manual") @db.VarChar(30)
  health_sync            Json?
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @db.Timestamp(6)

  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cycle_daily_logs cycle_daily_logs[]

  @@index([user_id], map: "index_cycle_profiles_user_id")
}

model cycle_daily_logs {
  id               String   @id @db.VarChar(64)
  cycle_profile_id String
  log_date         DateTime @db.Date
  energy           String?  @db.VarChar(20)
  flow_level       String?  @db.VarChar(20)
  symptoms         Json     @default("[]")
  mood             Json     @default("[]")
  created_at       DateTime @default(now()) @db.Timestamp(6)

  cycle_profiles cycle_profiles @relation(fields: [cycle_profile_id], references: [id], onDelete: Cascade)

  @@unique([cycle_profile_id, log_date], map: "index_cycle_daily_logs_profile_date")
  @@index([cycle_profile_id], map: "index_cycle_daily_logs_cycle_profile_id")
}

// Systems Table
// This table stores information about systems used by the platform
model systems {
  id          String   @id @db.VarChar(64)
  name        String  @unique(map: "index_systems_name") @db.VarChar(50)
  description String  @db.VarChar(255)
  is_internal Boolean @default(true)

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
}
