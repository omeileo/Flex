{
  "name": "@flex/api",
  "version": "0.1.0",
  "description": "Template Project API built with Express.js",
  "main": "server.ts",
  "author": "App Shop",
  "license": "ISC",
  "repository": "https://github.com/App-Shop-Apps/Template-Project-API",
  "private": true,
  "scripts": {
    "db:reset": "npx prisma migrate reset --force && npx prisma db push && npm run seed-database",
    "dev": "npm run update-git-hooks ; tsx watch --clear-screen=false src/server.ts | pino-pretty",
    "dev-only": "tsx watch --clear-screen=false src/server.ts | pino-pretty",
    "dev:reset-database": "npm run prisma:migrate-deploy-reset && npx prisma db push",
    "dev:reseed-database": "npm run seed-database && npm run seed-database:dev",
    "dev:clean-and-run": "npm run dev:reset-database && npm run prisma:migrate-dev && npm run dev:reseed-database && npm run dev",
    "docker:build": "docker compose -f docker-compose-local.yml up --build",
    "docker:run": "docker compose -f docker-compose-local.yml up",
    "build": "rimraf build && NODE_ENV=production tsup",
    "build:dev": "rimraf build && NODE_ENV=development tsup",
    "start": "node build/server.js",
    "clean": "rimraf node_modules package-lock.json build coverage",
    "clean:install": "npm run clean && npm i",
    "prisma:migrate-dev": "npx prisma migrate dev",
    "prisma:migrate-deploy": "npx prisma generate && npx prisma migrate deploy",
    "prisma:migrate-deploy-reset": "npx prisma migrate reset --force",
    "show-database-tables": "npx prisma studio --port 5557",
    "lint": "npx eslint .",
    "lint-init": "npx eslint --init .",
    "lint:fix": "npx eslint --fix .",
    "format": "prettier --config .prettierrc --write .",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "test:cov": "vitest run --coverage",
    "prepare": "husky",
    "update-git-hooks": "npx tsx src/shared/scripts/git/updateGitHooks.scripts.ts",
    "generate-api": "npx tsx src/shared/scripts/api/generateApiSet.scripts.ts",
    "seed-database": "npx tsx prisma/seed.ts",
    "seed-database:dev": "npx tsx prisma/devDataSeed.ts",
    "create-database-functions": "npx tsx prisma/databaseFunctions/databaseFunctions.ts",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "migration-query:dev": "npx tsx prisma/scripts/migration/runMigrationQuery.scripts.ts",
    "migration-query:prod": "NODE_ENV=production npx tsx prisma/scripts/migration/runMigrationQuery.scripts.ts",
    "check:product-flow-api-docs": "npx tsx src/shared/scripts/productFlows/checkProductFlowApiDrift.scripts.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.0.0",
    "@flex/shared": "*",
    "@node-rs/argon2": "1.8.3",
    "@prisma/adapter-pg": "5.16.1",
    "@prisma/client": "5.16.1",
    "aircodes": "1.3.16",
    "axios": "1.7.2",
    "cls-hooked": "4.2.2",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "country-state-city": "3.2.1",
    "cron": "3.1.7",
    "cronstrue": "2.50.0",
    "dotenv": "16.4.5",
    "envalid": "8.0.0",
    "express": "4.19.2",
    "express-handlebars": "^7.1.2",
    "express-rate-limit": "7.2.0",
    "helmet": "7.1.0",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.17.21",
    "luxon": "3.4.4",
    "micromatch": "4.0.8",
    "node-cache": "5.1.2",
    "nodemailer": "6.9.14",
    "nodemailer-express-handlebars": "6.1.2",
    "pg": "8.12.0",
    "pino": "9.6.0",
    "pino-http": "10.0.0",
    "prisma-error-enum": "0.1.3",
    "stripe": "16.12.0",
    "swagger-ui-express": "5.0.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "8.57.0",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/cls-hooked": "4.3.8",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/inquirer": "9.0.7",
    "@types/jsonwebtoken": "9.0.6",
    "@types/lodash": "4.17.6",
    "@types/luxon": "3.4.2",
    "@types/micromatch": "4.0.8",
    "@types/nodemailer": "6.4.15",
    "@types/nodemailer-express-handlebars": "4.0.5",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.6",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.4.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "15.4.0",
    "husky": "9.0.11",
    "inquirer": "9.3.0",
    "lint-staged": "15.2.2",
    "npm": "10.8.2",
    "pino-pretty": "11.0.0",
    "prettier": "3.3.1",
    "prisma": "5.16.1",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "tsup": "8.0.2",
    "tsx": "4.7.2",
    "typescript": "5.4.4",
    "typescript-eslint": "7.13.0",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "1.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  },
  "lint-staged": {
    "**/*": "npm run format",
    "**/*.{js,ts}": "npm run lint:fix"
  }
}
