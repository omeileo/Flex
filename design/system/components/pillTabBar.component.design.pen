{
  "version": "2.11",
  "themes": { "mode": ["light", "dark", "pink"] },
  "variables": {
    "accent-cta": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#111827" }, { "theme": { "mode": "dark" }, "value": "#F9FAFB" }, { "theme": { "mode": "pink" }, "value": "#DB2777" }] },
    "background": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#F7F8FA" }, { "theme": { "mode": "dark" }, "value": "#0F1117" }, { "theme": { "mode": "pink" }, "value": "#FFF0F5" }] },
    "border": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#E5E7EB" }, { "theme": { "mode": "dark" }, "value": "#374151" }, { "theme": { "mode": "pink" }, "value": "#F5C6DE" }] },
    "surface": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#FFFFFF" }, { "theme": { "mode": "dark" }, "value": "#1A1F2E" }, { "theme": { "mode": "pink" }, "value": "#FFFBFC" }] },
    "text-primary": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#111827" }, { "theme": { "mode": "dark" }, "value": "#F9FAFB" }, { "theme": { "mode": "pink" }, "value": "#3B1229" }] },
    "text-secondary": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#6B7280" }, { "theme": { "mode": "dark" }, "value": "#9CA3AF" }, { "theme": { "mode": "pink" }, "value": "#9D6280" }] },
    "text-inverse": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#FFFFFF" }, { "theme": { "mode": "dark" }, "value": "#111827" }, { "theme": { "mode": "pink" }, "value": "#FFFFFF" }] },
    "radius-pill": { "type": "number", "value": 36 }
  },
  "children": [
    {
      "type": "frame",
      "id": "tbHdr",
      "x": 80,
      "y": 40,
      "width": 1200,
      "layout": "vertical",
      "gap": 4,
      "children": [
        { "type": "text", "id": "tbTitle", "fill": "$text-primary", "content": "PillTabBar Component", "fontFamily": "Inter", "fontSize": 24, "fontWeight": "700" },
        { "type": "text", "id": "tbDesc", "fill": "$text-secondary", "textGrowth": "fixed-width", "width": 720, "content": "Floating capsule · 4 tabs · Today · Plan · Coach · Profile · active state = filled pill", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "400" }
      ]
    },
    {
      "type": "frame",
      "id": "cmpPillTabBar",
      "x": 80,
      "y": 120,
      "name": "component/PillTabBar",
      "reusable": true,
      "width": 326,
      "height": 64,
      "fill": "$surface",
      "stroke": { "thickness": 1, "fill": "$border" },
      "cornerRadius": "$radius-pill",
      "padding": 6,
      "alignItems": "center",
      "gap": 4,
      "children": [
        {
          "type": "frame",
          "id": "tbToday",
          "name": "Today",
          "width": "fill_container",
          "height": 52,
          "fill": "$accent-cta",
          "cornerRadius": 30,
          "padding": 8,
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 2,
          "children": [
            { "type": "icon_font", "id": "tbTodayIcon", "name": "Icon", "iconFontFamily": "lucide", "iconFontName": "calendar", "fill": "$text-inverse", "width": 18, "height": 18 },
            { "type": "text", "id": "tbTodayLbl", "name": "Label", "fill": "$text-inverse", "content": "Today", "fontFamily": "Inter", "fontSize": 11, "fontWeight": "600" }
          ]
        },
        {
          "type": "frame",
          "id": "tbPlan",
          "name": "Plan",
          "width": "fill_container",
          "height": 52,
          "fill": "#00000000",
          "cornerRadius": 30,
          "padding": 8,
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 2,
          "children": [
            { "type": "icon_font", "id": "tbPlanIcon", "name": "Icon", "iconFontFamily": "lucide", "iconFontName": "layout-grid", "fill": "$text-secondary", "width": 18, "height": 18 },
            { "type": "text", "id": "tbPlanLbl", "name": "Label", "fill": "$text-secondary", "content": "Plan", "fontFamily": "Inter", "fontSize": 11, "fontWeight": "500" }
          ]
        },
        {
          "type": "frame",
          "id": "tbCoach",
          "name": "Coach",
          "width": "fill_container",
          "height": 52,
          "fill": "#00000000",
          "cornerRadius": 30,
          "padding": 8,
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 2,
          "children": [
            { "type": "icon_font", "id": "tbCoachIcon", "name": "Icon", "iconFontFamily": "lucide", "iconFontName": "message-circle", "fill": "$text-secondary", "width": 18, "height": 18 },
            { "type": "text", "id": "tbCoachLbl", "name": "Label", "fill": "$text-secondary", "content": "Coach", "fontFamily": "Inter", "fontSize": 11, "fontWeight": "500" }
          ]
        },
        {
          "type": "frame",
          "id": "tbProfile",
          "name": "Profile",
          "width": "fill_container",
          "height": 52,
          "fill": "#00000000",
          "cornerRadius": 30,
          "padding": 8,
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 2,
          "children": [
            { "type": "icon_font", "id": "tbProfileIcon", "name": "Icon", "iconFontFamily": "lucide", "iconFontName": "user", "fill": "$text-secondary", "width": 18, "height": 18 },
            { "type": "text", "id": "tbProfileLbl", "name": "Label", "fill": "$text-secondary", "content": "Profile", "fontFamily": "Inter", "fontSize": 11, "fontWeight": "500" }
          ]
        }
      ]
    },
    {
      "type": "ref",
      "id": "tbPlanActive",
      "ref": "cmpPillTabBar",
      "name": "PillTabBar: Plan active",
      "x": 440,
      "y": 120,
      "descendants": {
        "tbToday": { "fill": "#00000000" },
        "tbTodayIcon": { "fill": "$text-secondary" },
        "tbTodayLbl": { "fill": "$text-secondary", "fontWeight": "500" },
        "tbPlan": { "fill": "$accent-cta" },
        "tbPlanIcon": { "fill": "$text-inverse" },
        "tbPlanLbl": { "fill": "$text-inverse", "fontWeight": "600" }
      }
    },
    {
      "type": "ref",
      "id": "tbProfileActive",
      "ref": "cmpPillTabBar",
      "name": "PillTabBar: Profile active",
      "x": 80,
      "y": 220,
      "descendants": {
        "tbToday": { "fill": "#00000000" },
        "tbTodayIcon": { "fill": "$text-secondary" },
        "tbTodayLbl": { "fill": "$text-secondary", "fontWeight": "500" },
        "tbProfile": { "fill": "$accent-cta" },
        "tbProfileIcon": { "fill": "$text-inverse" },
        "tbProfileLbl": { "fill": "$text-inverse", "fontWeight": "600" }
      }
    }
  ]
}
