{
  "version": "2.11",
  "themes": {
    "mode": ["light", "dark", "pink"]
  },
  "variables": {
    "accent-cta": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#111827" },
        { "theme": { "mode": "dark" }, "value": "#F9FAFB" },
        { "theme": { "mode": "pink" }, "value": "#DB2777" }
      ]
    },
    "accent-muted": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#D8E3FB" },
        { "theme": { "mode": "dark" }, "value": "#2D3748" },
        { "theme": { "mode": "pink" }, "value": "#FFD6E8" }
      ]
    },
    "background": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#F7F8FA" },
        { "theme": { "mode": "dark" }, "value": "#0F1117" },
        { "theme": { "mode": "pink" }, "value": "#FFF0F5" }
      ]
    },
    "border": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#E5E7EB" },
        { "theme": { "mode": "dark" }, "value": "#374151" },
        { "theme": { "mode": "pink" }, "value": "#F5C6DE" }
      ]
    },
    "surface": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#FFFFFF" },
        { "theme": { "mode": "dark" }, "value": "#1A1F2E" },
        { "theme": { "mode": "pink" }, "value": "#FFFBFC" }
      ]
    },
    "text-inverse": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#FFFFFF" },
        { "theme": { "mode": "dark" }, "value": "#111827" },
        { "theme": { "mode": "pink" }, "value": "#FFFFFF" }
      ]
    },
    "text-primary": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#111827" },
        { "theme": { "mode": "dark" }, "value": "#F9FAFB" },
        { "theme": { "mode": "pink" }, "value": "#3B1229" }
      ]
    },
    "text-secondary": {
      "type": "color",
      "value": [
        { "theme": { "mode": "light" }, "value": "#6B7280" },
        { "theme": { "mode": "dark" }, "value": "#9CA3AF" },
        { "theme": { "mode": "pink" }, "value": "#9D6280" }
      ]
    },
    "radius-pill": { "type": "number", "value": 36 },
    "spacing-md": { "type": "number", "value": 16 },
    "spacing-sm": { "type": "number", "value": 8 }
  },
  "children": [
    {
      "type": "frame",
      "id": "hdrBtn",
      "x": 80,
      "y": 40,
      "width": 1200,
      "layout": "vertical",
      "gap": 4,
      "children": [
        {
          "type": "text",
          "id": "tBtnTitle",
          "fill": "$text-primary",
          "content": "Button Component",
          "fontFamily": "Inter",
          "fontSize": 24,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "tBtnDesc",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": 720,
          "content": "Full-width pill CTA · primary · secondary · tertiary · destructive · disabled · loading",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "400"
        }
      ]
    },
    {
      "type": "frame",
      "id": "cmpBtnPrimary",
      "x": 80,
      "y": 120,
      "name": "component/Button/Primary",
      "reusable": true,
      "width": 358,
      "height": 56,
      "fill": "$accent-cta",
      "cornerRadius": "$radius-pill",
      "padding": 16,
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "id": "btnLabel",
          "name": "Label",
          "fill": "$text-inverse",
          "content": "Continue",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "600"
        }
      ]
    },
    {
      "type": "frame",
      "id": "cmpBtnSecondary",
      "x": 80,
      "y": 200,
      "name": "component/Button/Secondary",
      "reusable": true,
      "width": 358,
      "height": 56,
      "fill": "$surface",
      "stroke": { "thickness": 1, "fill": "$border" },
      "cornerRadius": "$radius-pill",
      "padding": 16,
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "id": "btnSecLabel",
          "name": "Label",
          "fill": "$text-primary",
          "content": "Skip for now",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "600"
        }
      ]
    },
    {
      "type": "frame",
      "id": "cmpBtnTertiary",
      "x": 80,
      "y": 280,
      "name": "component/Button/Tertiary",
      "reusable": true,
      "width": 358,
      "height": 56,
      "fill": "#00000000",
      "cornerRadius": "$radius-pill",
      "padding": 16,
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "id": "btnTertLabel",
          "name": "Label",
          "fill": "$accent-cta",
          "content": "Not now",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "600"
        }
      ]
    },
    {
      "type": "ref",
      "id": "refBtnDisabled",
      "ref": "cmpBtnPrimary",
      "name": "Button: Disabled",
      "x": 480,
      "y": 120,
      "opacity": 0.4,
      "descendants": {
        "btnLabel": { "content": "Continue" }
      }
    },
    {
      "type": "ref",
      "id": "refBtnLoading",
      "ref": "cmpBtnPrimary",
      "name": "Button: Loading",
      "x": 480,
      "y": 200,
      "descendants": {
        "btnLabel": { "content": "Saving…" }
      }
    },
    {
      "type": "frame",
      "id": "cmpBtnDestructive",
      "x": 480,
      "y": 280,
      "name": "component/Button/Destructive",
      "reusable": true,
      "width": 358,
      "height": 56,
      "fill": "#DC2626",
      "cornerRadius": "$radius-pill",
      "padding": 16,
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "id": "btnDestLabel",
          "name": "Label",
          "fill": "#FFFFFF",
          "content": "Delete account",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "600"
        }
      ]
    },
    {
      "type": "frame",
      "id": "cmpBtnIconLeft",
      "x": 80,
      "y": 360,
      "name": "component/Button/IconLeft",
      "reusable": true,
      "width": 358,
      "height": 56,
      "fill": "$accent-cta",
      "cornerRadius": "$radius-pill",
      "padding": 16,
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 8,
      "children": [
        {
          "type": "icon_font",
          "id": "btnIcon",
          "name": "Icon",
          "iconFontFamily": "lucide",
          "iconFontName": "sparkles",
          "fill": "$text-inverse",
          "width": 18,
          "height": 18
        },
        {
          "type": "text",
          "id": "btnIconLbl",
          "name": "Label",
          "fill": "$text-inverse",
          "content": "Generate plan",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "600"
        }
      ]
    }
  ]
}
