{
  "version": "2.11",
  "themes": { "mode": ["light", "dark", "pink"] },
  "variables": {
    "accent-cta": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#111827" }, { "theme": { "mode": "dark" }, "value": "#F9FAFB" }, { "theme": { "mode": "pink" }, "value": "#DB2777" }] },
    "accent-energy": { "type": "color", "value": "#22C55E" },
    "background": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#F7F8FA" }, { "theme": { "mode": "dark" }, "value": "#0F1117" }, { "theme": { "mode": "pink" }, "value": "#FFF0F5" }] },
    "border": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#E5E7EB" }, { "theme": { "mode": "dark" }, "value": "#374151" }, { "theme": { "mode": "pink" }, "value": "#F5C6DE" }] },
    "surface": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#FFFFFF" }, { "theme": { "mode": "dark" }, "value": "#1A1F2E" }, { "theme": { "mode": "pink" }, "value": "#FFFBFC" }] },
    "text-primary": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#111827" }, { "theme": { "mode": "dark" }, "value": "#F9FAFB" }, { "theme": { "mode": "pink" }, "value": "#3B1229" }] },
    "text-secondary": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#6B7280" }, { "theme": { "mode": "dark" }, "value": "#9CA3AF" }, { "theme": { "mode": "pink" }, "value": "#9D6280" }] }
  },
  "children": [
    {
      "type": "frame",
      "id": "phHdr",
      "x": 80,
      "y": 40,
      "width": 1200,
      "layout": "vertical",
      "gap": 4,
      "children": [
        { "type": "text", "id": "phTitle", "fill": "$text-primary", "content": "ProgressHeader Component", "fontFamily": "Inter", "fontSize": 24, "fontWeight": "700" },
        { "type": "text", "id": "phDesc", "fill": "$text-secondary", "textGrowth": "fixed-width", "width": 720, "content": "Stepper for onboarding · back chevron · step caption · segmented bar", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "400" }
      ]
    },
    {
      "type": "frame",
      "id": "cmpProgressHeader",
      "x": 80,
      "y": 120,
      "name": "component/ProgressHeader",
      "reusable": true,
      "width": 358,
      "height": 56,
      "fill": "$surface",
      "padding": [0, 16, 12, 16],
      "layout": "vertical",
      "gap": 12,
      "children": [
        {
          "type": "frame",
          "id": "phTopRow",
          "name": "TopRow",
          "width": "fill_container",
          "layout": "horizontal",
          "alignItems": "center",
          "gap": 12,
          "children": [
            { "type": "icon_font", "id": "phBack", "name": "Back", "iconFontFamily": "lucide", "iconFontName": "chevron-left", "fill": "$text-primary", "width": 24, "height": 24 },
            { "type": "text", "id": "phStep", "name": "Step", "fill": "$text-secondary", "content": "Step 3 of 11", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500" }
          ]
        },
        {
          "type": "frame",
          "id": "phBarTrack",
          "name": "BarTrack",
          "width": "fill_container",
          "height": 4,
          "fill": "$border",
          "cornerRadius": 2,
          "layout": "horizontal",
          "children": [
            { "type": "rectangle", "id": "phBarFill", "name": "BarFill", "width": 90, "height": 4, "fill": "$accent-energy", "cornerRadius": 2 }
          ]
        }
      ]
    },
    {
      "type": "ref",
      "id": "phStart",
      "ref": "cmpProgressHeader",
      "name": "ProgressHeader: Start",
      "x": 480,
      "y": 120,
      "descendants": {
        "phStep": { "content": "Step 1 of 11" },
        "phBarFill": { "width": 30 }
      }
    },
    {
      "type": "ref",
      "id": "phMid",
      "ref": "cmpProgressHeader",
      "name": "ProgressHeader: Mid",
      "x": 80,
      "y": 232,
      "descendants": {
        "phStep": { "content": "Step 6 of 11" },
        "phBarFill": { "width": 180 }
      }
    },
    {
      "type": "ref",
      "id": "phEnd",
      "ref": "cmpProgressHeader",
      "name": "ProgressHeader: End",
      "x": 480,
      "y": 232,
      "descendants": {
        "phStep": { "content": "Step 11 of 11" },
        "phBarFill": { "width": 326 }
      }
    }
  ]
}
