{
  "version": "2.11",
  "themes": { "mode": ["light", "dark", "pink"] },
  "variables": {
    "accent-cta": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#111827" }, { "theme": { "mode": "dark" }, "value": "#F9FAFB" }, { "theme": { "mode": "pink" }, "value": "#DB2777" }] },
    "accent-muted": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#D8E3FB" }, { "theme": { "mode": "dark" }, "value": "#2D3748" }, { "theme": { "mode": "pink" }, "value": "#FFD6E8" }] },
    "background": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#F7F8FA" }, { "theme": { "mode": "dark" }, "value": "#0F1117" }, { "theme": { "mode": "pink" }, "value": "#FFF0F5" }] },
    "border": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#E5E7EB" }, { "theme": { "mode": "dark" }, "value": "#374151" }, { "theme": { "mode": "pink" }, "value": "#F5C6DE" }] },
    "surface": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#FFFFFF" }, { "theme": { "mode": "dark" }, "value": "#1A1F2E" }, { "theme": { "mode": "pink" }, "value": "#FFFBFC" }] },
    "text-primary": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#111827" }, { "theme": { "mode": "dark" }, "value": "#F9FAFB" }, { "theme": { "mode": "pink" }, "value": "#3B1229" }] },
    "text-secondary": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#6B7280" }, { "theme": { "mode": "dark" }, "value": "#9CA3AF" }, { "theme": { "mode": "pink" }, "value": "#9D6280" }] },
    "text-inverse": { "type": "color", "value": [{ "theme": { "mode": "light" }, "value": "#FFFFFF" }, { "theme": { "mode": "dark" }, "value": "#111827" }, { "theme": { "mode": "pink" }, "value": "#FFFFFF" }] },
    "radius-lg": { "type": "number", "value": 16 },
    "spacing-md": { "type": "number", "value": 16 }
  },
  "children": [
    {
      "type": "frame",
      "id": "cnHdr",
      "x": 80,
      "y": 40,
      "width": 1200,
      "layout": "vertical",
      "gap": 4,
      "children": [
        { "type": "text", "id": "cnTitle", "fill": "$text-primary", "content": "CoachNote Component", "fontFamily": "Inter", "fontSize": 24, "fontWeight": "700" },
        { "type": "text", "id": "cnDesc", "fill": "$text-secondary", "textGrowth": "fixed-width", "width": 720, "content": "Avatar · contextual coach message · see more link · supports info / warning / encouragement tones", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "400" }
      ]
    },
    {
      "type": "frame",
      "id": "cmpCoachNote",
      "x": 80,
      "y": 120,
      "name": "component/CoachNote",
      "reusable": true,
      "width": 358,
      "fill": "$accent-muted",
      "cornerRadius": "$radius-lg",
      "padding": 16,
      "layout": "horizontal",
      "alignItems": "start",
      "gap": 12,
      "children": [
        {
          "type": "ellipse",
          "id": "cnAvatar",
          "name": "Avatar",
          "width": 36,
          "height": 36,
          "fill": "$accent-cta"
        },
        {
          "type": "frame",
          "id": "cnBody",
          "name": "Body",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            { "type": "text", "id": "cnAuthor", "name": "Author", "fill": "$text-primary", "content": "Coach", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "600" },
            { "type": "text", "id": "cnMsg", "name": "Message", "fill": "$text-primary", "textGrowth": "fixed-width", "width": "fill_container", "content": "Light week — I scaled volume by 15% so your knee can settle before next block.", "fontFamily": "Inter", "fontSize": 14, "fontWeight": "400", "lineHeight": 1.4 },
            { "type": "text", "id": "cnLink", "name": "Link", "fill": "$text-secondary", "content": "Why?", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "500", "underline": true }
          ]
        }
      ]
    },
    {
      "type": "ref",
      "id": "cnWarning",
      "ref": "cmpCoachNote",
      "name": "CoachNote: Warning",
      "x": 480,
      "y": 120,
      "fill": "#FEF3C7",
      "descendants": {
        "cnAvatar": { "fill": "#F59E0B" },
        "cnMsg": { "content": "You logged knee soreness twice this week — deload day swapped in for Friday's squat session." },
        "cnLink": { "content": "Review change" }
      }
    },
    {
      "type": "ref",
      "id": "cnEncourage",
      "ref": "cmpCoachNote",
      "name": "CoachNote: Encouragement",
      "x": 80,
      "y": 280,
      "fill": "#DCFCE7",
      "descendants": {
        "cnAvatar": { "fill": "#16A34A" },
        "cnAuthor": { "content": "Coach · streak" },
        "cnMsg": { "content": "Three consistent weeks. You're recovering between sessions faster than at week 1." },
        "cnLink": { "content": "See progress" }
      }
    },
    {
      "type": "ref",
      "id": "cnInline",
      "ref": "cmpCoachNote",
      "name": "CoachNote: Inline tip",
      "x": 480,
      "y": 280,
      "fill": "$surface",
      "stroke": { "thickness": 1, "fill": "$border" },
      "descendants": {
        "cnAvatar": { "fill": "$accent-cta" },
        "cnAuthor": { "content": "Tip" },
        "cnMsg": { "content": "Rest 90s between sets today — heavier load, lower reps." },
        "cnLink": { "enabled": false }
      }
    }
  ]
}
